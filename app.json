{
  "expo": {
    "name": "Transfer Black",
    "slug": "transfer-black-passenger",
    "scheme": "transferblack-passenger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0C",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.transferblack.passenger"
    },
    "android": {
      "package": "com.transferblack.passenger",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0C",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Transfer Black usa tu ubicación para ubicarte en el mapa y proponer tu punto de partida."
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#C9A85C",
          "defaultChannel": "default"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "69772fb2-c469-4bb3-b114-4c0a3ed4ff7c"
      }
    },
    "owner": "facundo19"
  }
}
