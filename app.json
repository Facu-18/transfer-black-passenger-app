{
  "expo": {
    "name": "Transfer Black",
    "slug": "transfer-black-passenger",
    "scheme": "transferblack-passenger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0C",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.transferblack.passenger"
    },
    "android": {
      "package": "com.transferblack.passenger",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0C",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Transfer Black usa tu ubicación para ubicarte en el mapa y proponer tu punto de partida."
        }
      ],
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ]
  }
}
