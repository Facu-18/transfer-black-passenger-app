# Copiar como .env. Todo lo que empieza con EXPO_PUBLIC_ queda escrito en el
# bundle de la app y cualquiera puede leerlo: nunca poner tokens ni secretos.

# URL base del backend, con el prefijo /api/v1. Por defecto, el desplegado en Render.
# Para un backend local desde un celular fisico, "localhost" es el propio celular:
# usar la IP de la PC en la red local, por ejemplo http://192.168.0.10:3000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Autocompletado de direcciones y "Ubicacion actual" (geocodificacion inversa).
# Queda legible dentro de la app: usar una key propia de la app, distinta de la
# del backend, y limitarla desde el panel de Geoapify.
EXPO_PUBLIC_GEOAPIFY_API_KEY=
